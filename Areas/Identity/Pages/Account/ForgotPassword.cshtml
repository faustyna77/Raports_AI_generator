@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Zapomniałeś hasła?";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="text-center mb-4">@ViewData["Title"]</h1>
            <h2>Wprowadź swój adres email</h2>
            <p class="text-muted">Wyślemy Ci link do resetowania hasła.</p>
            <hr />

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nazwa@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="w-100 btn btn-lg btn-primary">Wyślij link do resetowania</button>
            </form>

            <div class="text-center mt-3">
                <p><a asp-page="./Login">Powrót do logowania</a></p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}