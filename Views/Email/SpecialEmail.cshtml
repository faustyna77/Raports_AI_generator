@model AI_Raports_Generators.Models.ViewModels.SpecialEmail

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@{
    ViewData["Title"] = "Generowanie maila AI";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-4">📧 Generowanie maila</h2>

            <form asp-action="SpecialEmail" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="EmailAddress" class="form-label">Adres e-mail odbiorcy</label>
                    <input asp-for="EmailAddress" class="form-control" placeholder="np. kontakt@firma.pl" />
                    <span asp-validation-for="EmailAddress" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Topic" class="form-label">Temat wiadomości</label>
                    <input asp-for="Topic" class="form-control" placeholder="np. Prośba o spotkanie" />
                    <span asp-validation-for="Topic" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Purpose" class="form-label">Treść/zamiar maila</label>
                    <textarea asp-for="Purpose" class="form-control" rows="4" placeholder="Opisz, czego dotyczy wiadomość..."></textarea>
                    <span asp-validation-for="Purpose" class="text-danger small"></span>
                </div>

                <!-- Przycisk generuj zawsze -->
                <button type="submit" name="submit" value="generate" class="btn btn-success w-100 mt-3">✉️ Generuj e-mail</button>

                @if (!string.IsNullOrEmpty(Model.GeneratedEmail))
                {
                    <hr class="my-3" />

                    <!-- Pole edytowalne -->
                    <div class="mb-3">
                        <label class="form-label">📨 Edytuj wygenerowaną treść e-maila:</label>
                        <textarea asp-for="GeneratedEmail" class="form-control" rows="10"></textarea>
                        <span asp-validation-for="GeneratedEmail" class="text-danger small"></span>
                    </div>

                    <!-- Przycisk zapisz -->
                    <button type="submit" name="submit" value="save" class="btn btn-primary w-100 mt-2 mb-2">💾 Zapisz e-mail</button>

                  

                    <!-- Pobierz PDF -->
                    <a asp-action="DownloadEmailPdf" asp-route-id="@ViewBag.EmailId" class="btn btn-secondary w-100 mt-2">📄 Pobierz PDF</a>
                }
            </form>
        </div>
    </div>
</div>
