@using AI_Raports_Generators.Models.ViewModels

<h2>📝 Wygeneruj post na bloga</h2>

<form asp-action="GenerateReport" asp-controller="Test" method="post">
    <div class="mb-3">
        <label class="form-label">🎯 Temat posta:</label>
        <input type="text" name="postTitle" class="form-control" placeholder="Np. Jak AI zmienia biznes?" required value="@ViewBag.PostTitle" />
    </div>

    <div class="mb-3">
        <label class="form-label">🏷️ Hashtagi:</label>
        <input type="text" name="hashtags" class="form-control" placeholder="#AI #Biznes #Technologia" />
    </div>

    <div class="mb-3">
        <label class="form-label">✍️ Liczba słów:</label>
        <input type="number" name="wordCount" class="form-control" placeholder="Np. 500" min="100" max="5000" value="500" />
    </div>

    <div class="mb-3">
        <label class="form-label">🎛️ Temperatura (kreatywność):</label>
        <input type="range" name="temperature" class="form-range" min="0" max="1" step="0.1" value="0.7"
               oninput="document.getElementById('tempValue').innerText = this.value" />
        <span id="tempValue">0.7</span>
    </div>

    <button type="submit" class="btn btn-primary">🚀 Wygeneruj posta</button>
</form>

@if (ViewBag.AIReport != null)
{
    <h3 class="mt-4">📌 Wygenerowany post:</h3>
    <form method="post" asp-action="SaveEditedReport">
        <input type="hidden" name="postTitle" value="@ViewBag.PostTitle" />
        <textarea name="editedReport" rows="20" cols="100" class="form-control mb-3">@ViewBag.AIReport</textarea>
        <button type="submit" class="btn btn-success">💾 Zapisz do Moich Dokumentów</button>
    </form>
}
