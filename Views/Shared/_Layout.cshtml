<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Generator dokumentów AI</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AI_Raports_Generators.styles.css" asp-append-version="true" />
    <style>
        body {
            font-size: 0.92rem; /* Zmniejszona czcionka */
        }

        .navbar-brand {
            font-weight: 600;
            font-size: 1.1rem;
        }

        .nav-link {
            font-size: 0.92rem;
        }

        footer.footer {
            font-size: 0.85rem;
            padding-top: 1rem;
            padding-bottom: 1rem;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                    AI Generator
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Rozwiń menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Strona główna</a>
                        </li>
                       
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Document" asp-action="Generate">Generuj dokument</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Raport" asp-action="SpecialRaport">Generuj specjalny raport </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Email" asp-action="SpecialEmail">Generuj maila</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Raport" asp-action="MyDocuments">Moje dokumenty</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Test" asp-action="Test">Generuj post </a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container pb-3">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-light mt-auto">
        <div class="container text-center">
            &copy; 2025 - AI Generator Dokumentów - <a asp-controller="Home" asp-action="Privacy">Polityka prywatności</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
