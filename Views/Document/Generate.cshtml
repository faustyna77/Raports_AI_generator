@model AI_Raports_Generators.Models.ViewModels.GenerateDocumentViewModel

@{
    ViewData["Title"] = "Generuj dokument AI";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">
            <h2 class="mb-4">📝 Generuj dokument AI</h2>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <form asp-action="@ViewContext.RouteData.Values["action"]" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Title" class="form-label">Tytuł dokumentu:</label>
                    <input asp-for="Title" class="form-control" placeholder="Np. Raport miesięczny" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label for="Prompt" class="form-label">Podaj temat / opis dokumentu:</label>
                    <textarea asp-for="Prompt" class="form-control" rows="4" placeholder="Opisz, co ma zawierać dokument..."></textarea>
                    <span asp-validation-for="Prompt" class="text-danger small"></span>
                </div>

                <button type="submit" name="submit" value="generate" class="btn btn-success w-100 mb-3">🟢 Generuj dokument</button>

                @if (!string.IsNullOrEmpty(Model.GeneratedContent))
                {
                    <hr class="my-3" />
                    <h5>📄 Treść wygenerowana przez AI (możesz edytować):</h5>
                    <textarea asp-for="GeneratedContent" class="form-control mb-3" rows="10"></textarea>
                    <span asp-validation-for="GeneratedContent" class="text-danger small"></span>

                   
                    

                  
                    <button type="submit" name="submit" value="save" class="btn btn-primary w-100 mb-2">💾 Zapisz / Zaktualizuj dokument</button>

                    @* Pobierz PDF *@
                    @if (ViewBag.DocumentId != null)
                    {
                        <a asp-action="DownloadPdf" asp-route-id="@ViewBag.DocumentId" class="btn btn-secondary w-100 mb-2" target="_blank">📄 Pobierz PDF</a>
                    }

                  
                }
            </form>
        </div>
    </div>
</div>
