@using AI_Raports_Generators.Models.Domains
@using AI_Raports_Generators.Models.ViewModels

@model MyDocumentsViewModel

<h2>📄 Moje dokumenty</h2>

@if (Model.Documents.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Tytuł</th>
                <th>Data utworzenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var doc in Model.Documents)
            {
                <tr>
                    <td>@doc.Title</td>
                    <td>@doc.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <!-- Pobieranie i edycja dokumentów -->
                        <a asp-action="DownloadPdf" asp-controller="Document" asp-route-id="@doc.Id" class="btn btn-sm btn-primary">Pobierz PDF</a>
                        <a asp-action="Edit" asp-controller="Document" asp-route-id="@doc.Id" class="btn btn-sm btn-warning">Edytuj</a>
                        <!-- Jeśli chcesz mieć "drukuj", można użyć DownloadPdf -->
                        <a asp-action="Print" asp-controller="Raport" asp-route-id="@doc.Id" target="_blank" class="btn btn-sm btn-secondary">
                            Drukuj
                        </a>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nie masz jeszcze żadnych dokumentów.</p>
}

<hr />

<h2>📧 Moje e-maile</h2>

@if (Model.Emails.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Adres e-mail</th>
                <th>Temat</th>
                <th>Cel</th>
                <th>Data utworzenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var email in Model.Emails)
            {
                <tr>
                    <td>@email.EmailAddress</td>
                    <td>@email.Topic</td>
                    <td>@email.Purpose</td>
                    <td>@email.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <!-- Edycja i pobieranie maili -->
                        <a asp-action="EditEmail" asp-controller="Email" asp-route-id="@email.Id" class="btn btn-sm btn-warning">Edytuj</a>
                        <a asp-action="DownloadEmailPdf" asp-controller="Email" asp-route-id="@email.Id" class="btn btn-sm btn-primary">Pobierz PDF</a>

                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Nie masz jeszcze żadnych maili.</p>
}
